<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net472;net10.0;net11.0;</TargetFrameworks>
		<Product>$(AssemblyName) ($(TargetFramework))</Product>
		<Description>.Net client library for accessing the Fetchify(Formerly CraftyClicks) JSON Api</Description>
		<Title>DSoft.Fetchify.Api.Client</Title>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Added .NET 11.0 support alongside .NET 10.0 and updated packages.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net11.0' ">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' != 'net11.0' ">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net472' ">
		<PackageReference Include="System.Text.Json" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
