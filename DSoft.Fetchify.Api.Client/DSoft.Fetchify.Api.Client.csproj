<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net472;net10.0;</TargetFrameworks>
		<Product>$(AssemblyName) ($(TargetFramework))</Product>
		<Description>.Net client library for accessing the Fetchify(Formerly CraftyClicks) JSON Api</Description>
		<Title>DSoft.Fetchify.Api.Client</Title>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Updated to .NET 10.0 and latest packages, dropped .NET 8.0 and .NET 9.0 support.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net472' ">
		<PackageReference Include="System.Text.Json" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
